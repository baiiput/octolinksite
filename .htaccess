RewriteEngine On

# Paksa HTTPS (sudah ada)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www ke non-www (pilih salah satu)
RewriteCond %{HTTP_HOST} ^www\.octolink\.id [NC]
RewriteRule ^(.*)$ https://octolink.id/$1 [L,R=301]

# ========== INVOICE SHORT URL (PRIORITAS TINGGI) ==========
# Rule ini HARUS diletakkan sebelum rule .html extension
# Tangkap 8-character alphanumeric yang bukan folder/file existing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|payment|sl|admin|dashboard|assets|css|js|images)/
RewriteRule ^([a-zA-Z0-9]{8})$ payment/invoice.php?link=$1 [L,QSA]

# URL pendek ke proxy (sudah ada) 
RewriteRule ^adm\.sl$ sl/admin.php [L]
RewriteRule ^cl$ sl/client.php [L]
RewriteRule ^stat$ sl/status.php [L]
RewriteRule ^sug$ sl/suggest.php [L]
RewriteRule ^rpt$ sl/report.php [L]
RewriteRule ^data$ sl/data.php [L]
RewriteRule ^bromo$ bromo.html [L]

# Remove trailing slash (kecuali untuk direktori)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Remove .html extension dari URL
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Add .html extension (SETELAH short URL rule)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# EXCLUDE short URL pattern dari rule ini
RewriteCond %{REQUEST_URI} !^/[a-zA-Z0-9]{8}$
# EXCLUDE existing paths
RewriteCond %{REQUEST_URI} !^/(api|payment|sl|admin|dashboard)/
RewriteRule ^([^.]+)$ $1.html [L]

# Compression GZIP untuk speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Browser caching untuk speed
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 7 days"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # CORS untuk API
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# Handle CORS preflight untuk API
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^(.*)$ $1 [R=200,L]

# Block bad bots
RewriteCond %{HTTP_USER_AGENT} (ahrefs|semrush|mj12bot|dotbot) [NC]
RewriteRule .* - [F,L]

# Prevent directory browsing
Options -Indexes

# Protect sensitive files
<Files ~ "\.(env|log|sql|backup)$">
    Order allow,deny
    Deny from all
</Files>